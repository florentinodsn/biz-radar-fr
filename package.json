{
  "name": "biz-radar-fr",
  "version": "1.0.0",
  "description": "Veille automatisée d'entreprises à racheter en France (cessions retraite + reprises judiciaires)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "radar": "tsx src/index.ts",
    "radar:dry": "tsx src/index.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/scripts/initDb.ts"
  },
  "keywords": [
