    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "openai": "^4.104.0",
    "serpapi": "^2.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
