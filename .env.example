# === Collecte (obligatoire) ===
# Clé SerpAPI : https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# === Scoring IA (au moins une des deux) ===
# Gemini Flash (recommandé) : https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative OpenAI GPT-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here

# Fournisseur forcé : "gemini" | "openai" (auto si omis)
# AI_PROVIDER=gemini

# === Alertes Telegram (optionnel) ===
# Créer un bot via @BotFather, puis récupérer chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Options runtime ===
# Filtrer Google sur la dernière semaine (true/false, défaut: true)
SERPAPI_WEEKLY_ONLY=true

# Score minimum pour alerte Telegram (défaut: 70)
ALERT_SCORE_THRESHOLD=70

# Limite de résultats SerpAPI par thèse (défaut: 10)
SERPAPI_NUM_RESULTS=10
